# Copy to .env and fill in what you have. Everything is optional.

# Shown in the crawler's User-Agent so site owners can reach you (URL or email).
LEAD_ENGINE_CONTACT=

# FREE, NO CARD: Tavily web search. Sign up at https://app.tavily.com and copy the key
# (starts with tvly-) from the dashboard. 1,000 free searches/month; the app uses one per
# business when you click Find website / Re-check site, and stops at TAVILY_MONTHLY_LIMIT.
TAVILY_API_KEY=
TAVILY_MONTHLY_LIMIT=950

# Always on, free, no key: guess web addresses from business names (e.g. joesgrill.com)
# and keep one only if the page shows the business's phone or name + street address.
DOMAIN_GUESS=true

# Brave Search API key: finds websites when no source lists one. Brave has no free plan
# since Feb 2026: ~$5 of monthly credit (~1,000 searches), card required, overage billed
# with no cap. The app stops at BRAVE_MONTHLY_LIMIT searches and only searches when you
# click Find website / Re-check site, unless WEBSITE_SEARCH_AUTO=true.
BRAVE_API_KEY=
BRAVE_MONTHLY_LIMIT=900
WEBSITE_SEARCH_AUTO=false

# Google Places API (New) key. PAID beyond the free allowance: leave empty unless you accept that.
# Used to find websites and to check Google review counts (skip leads with more than
# max_google_reviews, set in the profile; default 50).
GOOGLE_PLACES_API_KEY=
# Stop calling Places after this many calls per calendar month (1,000/month are free).
GOOGLE_PLACES_MONTHLY_LIMIT=900

# Folder for downloaded Sunbiz data files (doc/cor/yyyymmddc.txt, doc/fic/yyyymmddf.txt).
SUNBIZ_IMPORT_DIR=

# Claude API key for on-demand AI lead briefs and outreach drafts.
ANTHROPIC_API_KEY=
